.{
    .name = .glyphwire,
    .version = "0.5.0",
    .fingerprint = 0x13e00fabb58419a6,
    .minimum_zig_version = "0.17.0-dev.1857+3c46da14d",
    .dependencies = .{
        .testz = .{
            .url = "https://github.com/srjilarious/testz/archive/refs/tags/v1.5.0.tar.gz",
            .hash = "testz-1.5.0-abaPyQ7NAQBYXILEqHI3PWLZTK0MNb6yXp0foUmJAdT9",
        },
        .zargunaught = .{
            .url = "https://github.com/srjilarious/zargunaught/archive/refs/tags/v1.3.0.tar.gz",
            .hash = "zargunaught-1.3.0-aoeNI6LpAABBxLqvvp6G4e9Mx-xDG3QfJ9aJ4WEkA54g",
        },
        // Vendored Lua 5.3 so glyphwire-shell can embed a Lua state for
        // ~/.config/glyphwire/shell.conf without pulling in the whole
        // engine (SDL3/OpenGL). `lua53` is ziglua's own lazy dependency,
        // listed here so `zig build --fetch` grabs the Lua source tarball
        // too.
        .ziglua = .{
            .path = "libs/ziglua",
        },
        .lua53 = .{
            .url = "https://www.lua.org/ftp/lua-5.3.6.tar.gz",
            .hash = "N-V-__8AALihEACTeiI1Me9rP-qPZT3BNTELDoSAXn76FIhw",
        },
        .sdl = .{
            .url = "git+https://github.com/allyourcodebase/SDL.git#5d74fc4ba994547f7f2f77695c2f301298310d4d",
            .hash = "sdl-1.0.2+3.4.14-i4QD0SawqQBSVdA6eHm0lX16h_Jwf1vQXxI_lO0-09sY",
        },
        .zopengl = .{
            .url = "git+https://github.com/srjilarious/zopengl.git#cdb08b0060f6c199acc9f2e533a9545f4878d2c9",
            .hash = "zopengl-0.6.0-dev-5-tnz9ynDgBHZidal8DWXWLsr8ESvSbzdmHrUuEABDwI",
        },
        .zmath = .{
            .url = "git+https://github.com/srjilarious/zmath.git#bab79674ed9b15014c319f29aa37996f878f6db2",
            .hash = "zmath-0.11.0-dev-wjwivSQuAwDgT9ShRl3HsHon9VccYgojbk7lz0qsYPUs",
        },
        .zstbi = .{
            .url = "git+https://github.com/srjilarious/zstbi.git#820a20adb1a07c3d050d2fc52b5dedb90b3bf2e8",
            .hash = "zstbi-0.11.0-dev-L0Ea_1iYBwBAN5Adaw13bU1LwWhTEMcmX9q9cbWzwydF",
        },
        // zoe's syntax highlighting. `tree_sitter` is the Zig binding plus
        // the vendored libtree-sitter C runtime; it's linked into `zoe`
        // (and the test runner, via `zoe_support`). It is pinned to the
        // exact commit `testz` already depends on for its ANSI code
        // highlighting, so the build graph has a single zig-tree-sitter
        // instance -- two different pins collide on the shared
        // `src/parser.zig`. The `grammar_*` entries are only the parser
        // *sources*: `build.zig` compiles each into a standalone
        // `parser.so` that zoe `dlopen`s at runtime, so they're lazy --
        // `zig build` only fetches them because the grammar-install step
        // runs. Adding a language later is a grammar dir on disk, not a
        // dependency here.
        .tree_sitter = .{
            .url = "git+https://github.com/srjilarious/zig-tree-sitter#94292e3fb9817b5a023d4dd99c13ed66139031a4",
            .hash = "tree_sitter-0.26.0-8heIf1jzDACYun1SYfDfljvDEqUHpselif-ozckvjarH",
        },
        .grammar_json = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-json.git#254c42a6476413b776221e03982ac8ae159eeb72",
            .hash = "N-V-__8AADVfAgBNtlL1cP9ero7uOPCZQ9tNRy-IM6sWkdpU",
            .lazy = true,
        },
        .grammar_zig = .{
            .url = "git+https://github.com/srjilarious/tree-sitter-zig.git#66e374d518616f18ee9e0ea71b0ec3d120c16e61",
            .hash = "tree_sitter_zig-1.1.3-C0B1jLd2XACced7oUU76wpfA6DMrYHISwhEJp-7edP2O",
            .lazy = true,
        },
        .grammar_python = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-python.git#26855eabccb19c6abf499fbc5b8dc7cc9ab8bc64",
            .hash = "N-V-__8AAOiqPgC9tH5tYSAYNsMWLoPiSxcmkHvIhMnezomx",
            .lazy = true,
        },
        .grammar_toml = .{
            .url = "git+https://github.com/tree-sitter-grammars/tree-sitter-toml.git#64b56832c2cffe41758f28e05c756a3a98d16f41",
            .hash = "N-V-__8AAKI7BABbJ5LWswYbVPhQVdmSYR9zKxmZ7ob_RSNI",
            .lazy = true,
        },
        .grammar_markdown = .{
            .url = "git+https://github.com/tree-sitter-grammars/tree-sitter-markdown.git#a0a00f817d02412bd92c54d316f164d827b57b5c",
            .hash = "N-V-__8AAPRhUwBHS53YVU2fqpXuZ8VMvL_vIKp2AQo4Ja7V",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
        "tests",
        "shell",
        "server",
        "client",
        "demo",
        "host",
        "host_eng",
        "ls",
        "view",
        "assets",
        "libs",
    },
}
