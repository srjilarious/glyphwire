.{
    .name = .glyphwire,
    .version = "0.1.0",
    .fingerprint = 0x13e00fabb58419a6,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .testz = .{
            .url = "https://github.com/srjilarious/testz/archive/refs/tags/v1.4.0.tar.gz",
            .hash = "testz-1.4.0-abaPydnMAQAJayUfCw4dw1MdiaiOS_A_iJGm1qES0bQo",
        },
        .pixzig = .{
            .path = "../pixzig",
        },
        .zargunaught = .{
            .url = "https://github.com/srjilarious/zargunaught/archive/refs/tags/v1.2.1.tar.gz",
            .hash = "zargunaught-1.2.1-aoeNIzTpAAArdAo7Hjp1FfdI6BYKPlZMRL2YRP6kc2UN",
        },
        // Vendored from pixzig/libs/ziglua so glyphwire-shell can embed a
        // Lua 5.3 state for ~/.config/glyphwire/shell.conf without pulling
        // in the whole pixzig engine (GLFW/OpenGL). `lua53` is ziglua's
        // own lazy dependency, listed here so `zig build --fetch` grabs
        // the Lua source tarball too -- mirrors pixzig's build.zig.zon.
        .ziglua = .{
            .path = "libs/ziglua",
        },
        .lua53 = .{
            .url = "https://www.lua.org/ftp/lua-5.3.6.tar.gz",
            .hash = "N-V-__8AALihEACTeiI1Me9rP-qPZT3BNTELDoSAXn76FIhw",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "shell",
        "server",
        "client",
        "demo",
        "host",
        "ls",
        "view",
        "assets",
        "libs",
    },
}
