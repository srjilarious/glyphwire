-- gw-shell configuration template.
--
-- This is the full reference for `shell.conf`, the file gw-shell
-- runs once at startup (see shell/config.zig `load`). Copy it to one of:
--
--   $GLYPHWIRE_CONFIG_DIR/shell.conf
--   $XDG_CONFIG_HOME/glyphwire/shell.conf
--   ~/.config/glyphwire/shell.conf                 (the usual location)
--
-- Every binding below is listed at its built-in default with every line
-- commented out, so copying this file verbatim changes nothing. Uncomment
-- and edit only what you want. Every binding is optional; a Lua syntax or
-- runtime error is shown on the grid and startup continues with whatever
-- ran before the error.
--
-- Syntax: it's a plain Lua script with the standard libraries open, so
-- loops / conditionals / `string` / `table` all work. It runs in the
-- shell's session-long Lua state, so a `function` (or `defcmd`) it
-- defines stays callable as a builtin afterwards. glyphwire adds:
-- `alias(name, value)`, `prompt{ ... }`, `zj{ ... }`, `on{ ... }`,
-- `defcmd(name, fn)`,
-- and the `sh` table (`sh.setenv` / `sh.unsetenv` / `sh.getenv` /
-- `sh.cwd` / `sh.chdir` / `sh.realpath`). See the Scripts section below.


---- Aliases ------------------------------------------------------------
--
-- alias(name, value) -- expands `name` when it's the first word of a
-- command line. Chains are followed once, and a name never expands to
-- itself, so `alias("ls", "ls --color")` is safe. Later calls win.
--
-- alias("ll", "ls -l")
-- alias("la", "ls -a")
-- alias("gs", "git status")


---- Open actions -----------------------------------------------------
--
-- open_actions{ [key] = command } -- what runs when you activate a
-- gw-ls entry (click it, or press Enter/Space while browsing).
-- gw-ls tags each entry with its `kind` ("file" / "directory" /
-- "symlink" / "other") and, for a file, a real `mimetype`; the key is
-- matched most-specific first:
--
--   1. the exact mimetype   ["image/png"]
--   2. the mimetype group   ["image/*"]
--   3. the kind keyword     ["directory"]
--
-- Your entries are merged over the built-in defaults (a key you set
-- replaces that default; a later call wins for the same key). The
-- defaults are:
--
--   open_actions{
--     ["directory"]  = "cd {sel}",
--     ["image/png"]  = "gw-view {selections}",
--     ["image/jpeg"] = "gw-view {selections}",
--     ["image/gif"]  = "gw-view {selections}",
--     ["image/bmp"]  = "gw-view {selections}",
--   }
--
-- The command is a template. `{sel}` expands to one shell-quoted path
-- and is an error if more than one entry is selected; `{selections}`
-- expands to one or more, space-separated. A template with neither runs
-- as-is. A value can also be a list of commands (`{ "ark {sel}",
-- "unzip {sel}" }`) -- only the first runs today, the rest are reserved
-- for a future action menu.
--
-- Ctrl+click (or Space while browsing) marks several entries; a plain
-- click / Enter then runs the first mark's action over every marked
-- path. Ctrl+Shift+C with entries marked copies their paths.
--
-- open_actions{
--   ["application/zip"] = "ark {selections}",
--   ["text/*"]          = "code {sel}",   -- any text/* file into an editor
--   ["file"]            = "xdg-open {sel}", -- catch-all for other files
-- }


---- Directory jumping (zj) -----------------------------------------
--
-- Every `cd` records the directory you landed in; `zj QUERY` then jumps
-- to the best-ranked match (a `z` / zoxide clone). Matching is
-- case-insensitive substring, with the last term also having to match the
-- final path component -- `zj dow` goes to ~/Downloads from anywhere.
-- Bare `zj` goes home; `zj ../sibling` (an existing path) acts like `cd`.
-- The database is ~/.config/glyphwire/z.db, written on exit and
-- periodically. $HOME and / are never recorded.
--
-- zj{
--   enabled = true,                       -- set false to turn it off
--   exclude_dirs = { "/tmp", "~/scratch" }, -- never record or return these (or anything under them)
-- }


---- Directory-change hook (on) -------------------------------------
--
-- on{ chdir = { ... } } -- run a command after the shell's working
-- directory changes. `list` picks when:
--
--   "off"      -- never
--   "always"   -- after every change (`cd`, `zj`, `sh.chdir`, or
--                 picking a directory in a gw-ls listing)
--   "metadata" -- only after picking a directory in a gw-ls listing
--                 (a click, or Enter/Space while browsing), not a
--                 typed `cd` / `zj`
--
-- `command` is a full command line, run as its own line right after the
-- change (so a glyphwire-aware lister still handshakes). The defaults:
--
-- on{
--   chdir = {
--     list = "metadata",
--     command = "gw-ls -lS",
--   },
-- }


---- Scripts ----------------------------------------------------------
--
-- A builtin is either a `defcmd(name, fn)` registration here, or a file
-- `<config_dir>/scripts/<name>.lua` (looked up by basename, re-read on
-- every call so editing it takes effect immediately). Dispatch
-- precedence: core builtins (cd / exit / alias / unalias) > aliases >
-- script builtins > $PATH -- so a `cd.lua` can't shadow the real `cd`,
-- but a `ls.lua` does shadow `/usr/bin/ls`.
--
-- A builtin receives its arguments as `...` and as the `arg` table
-- (`arg[0]` is the command name); a numeric `return` is its exit status.
-- `print` and `io.write` go to the terminal. `os.exit` is disabled (it
-- would kill the shell). `require` finds shared helpers under
-- `<config_dir>/scripts/lib/`. `os.execute` / `io.popen` work but run a
-- real subprocess outside the grid.
--
-- The `sh` table:
--   sh.setenv(name, value)   set a variable for this shell and every
--                            command it launches afterwards
--   sh.unsetenv(name)        remove one
--   sh.getenv(name)          the shell's live value, or nil
--   sh.cwd()                 absolute working directory
--   sh.realpath(path)        canonical absolute path, or nil if it
--                            doesn't resolve on disk
--
-- A runaway script is stopped by Ctrl-C, or a 30s wall-clock ceiling.
--
-- defcmd("hello", function(who)
--   print("hi " .. (who or "there"))
-- end)
--
-- See assets/scripts/ for up / venv_activate / venv_deactivate /
-- drop / yoink, ready to copy into ~/.config/glyphwire/scripts/.


---- Prompt -----------------------------------------------------------
--
-- prompt{ ... } -- one table argument, every key optional. Multiple
-- prompt{} calls merge, last write winning per key. Leave it out entirely
-- to keep the built-in "<cwd> > " prompt.
--
-- Tokens (usable in every template string, including a segment's `text`):
--   {cwd}        working directory, $HOME shown as ~
--   {cwd_full}   working directory, absolute
--   {user}       $USER
--   {host}       hostname
--   {time}       local time (strftime `time_format`, default %H:%M)
--   {env:NAME}   an environment variable ("" if unset)
--   {icon:NAME}  a bundled icon, one cell wide. NAME is the icon file's
--                path under assets/icons/ without the .png -- e.g.
--                distro/arch, distro/tux; per-file-type icons
--                file/pdf, file/document, file/code, ...; and the
--                prompt status glyphs status/error (a red cross, pair
--                with when = "error") and status/slow (a stopwatch, pair
--                with when = "slow").
--   {exit}       expands to the `exit` sub-template, only on a non-zero exit
--   {dur}        expands to the `dur` sub-template, only when the last
--                command ran for at least `dur_min_ms`
--   {NAME}       a command var declared in `commands = { ... }` (below) --
--                expands to that command's trimmed stdout, run on demand
--   {{  }}       literal braces;  \n \t \\  are unescaped
--
-- Inside the `exit` sub-template: {exit_code} is the number.
-- Inside the `dur` sub-template:  {duration} is the humanized time
--                                 (e.g. 450ms, 1.5s, 2m5s).


---- Command vars: prompt{ commands = { ... } } ----------------------
--
-- A map of var name -> shell command. Each command runs through
-- `/bin/sh -c` *on demand* -- only when a segment's text or a `when`
-- clause actually references `{name}` this prompt -- and `{name}` expands
-- to its trimmed stdout. Results are cached for the life of one prompt
-- (the idle right-side redraw reuses them), then re-run for the next.
--
-- A value is either the command string, or a table adding:
--   when       a `{var}` expression; the command runs only if it's truthy
--              (non-empty, not `0`/`false`; a leading `!` negates). Lets a
--              `git` command be gated on a cheap "in a repo?" probe so it
--              never runs outside one.
--   timeout_ms per-command wall-clock cap (default 400). On timeout the
--              child is killed and `{name}` is empty.
--
-- In a `when` clause (a segment's or another command's), `{name}` is
-- "true" when the command produced non-empty output -- so a probe just
-- needs to print something (or nothing) rather than rely on its exit code.
--
-- prompt {
--     commands = {
--         is_repo  = "git rev-parse --is-inside-work-tree 2>/dev/null",
--         branch   = { "git branch --show-current",            when = "{is_repo}" },
--         dirty    = { "git status --porcelain | grep -q . && echo '*'",
--                                                              when = "{is_repo}" },
--         modified = { "git status --porcelain | grep -c '^ M' | grep -v '^0$'",
--                                                              when = "{is_repo}" },
--     },
--     right_segments = {
--         { " {icon:distro/arch} {branch}{dirty} {modified} ",
--           when = "{is_repo}", fg = "#fff", bg = "#3a3a3a" },
--     },
-- }


-- (A) Plain template strings.
--
-- prompt {
--     -- Left side, drawn before the input.
--     left = "{cwd}{exit} > ",
--     -- Right side, right-aligned on the prompt row. "" = none.
--     right = "",
--     -- What {exit} expands to after a non-zero exit.
--     exit = " [{exit_code}]",
--     -- What {dur} expands to when the last command was slow.
--     dur = "  {duration}",
--     -- Minimum last-command run time, in ms, before {dur} (and a
--     -- when = "slow" segment) renders anything.
--     dur_min_ms = 2000,
-- }


-- (B) Powerline segments. left_segments / right_segments are lists of
-- { text (or positional [1]), fg, bg, when }.  A segment whose text
-- renders empty is dropped.  `when` is "always" (default), "error" (shown
-- only after a non-zero exit), "slow" (only when the last command took
-- >= dur_min_ms), or a `{var}` expression (shown only when it renders
-- truthy against the command vars -- e.g. when = "{is_repo}", or
-- "!{is_repo}").  Segments are joined with `sep` (fg = the left
-- segment's bg, bg = the right segment's bg -- the powerline trick) and
-- capped with head / tail / right_head.  The \u{E0Bx} glyphs need a Nerd
-- Font; glyphwire bundles a Powerline-range fallback face.
--
-- A worked two-line powerline setup (a distro badge + user + cwd on the
-- left; an error segment, a slow-command segment, and a clock on the
-- right). The when = "error" / when = "slow" segments only appear after a
-- failing / slow command, and pair with the status/error / status/slow
-- icons.
--
-- prompt {
--     left_segments = {
--         { "{icon:distro/arch}", fg = "#000", bg = "#3a3a3a" },
--         { " {user} ",           fg = "#fff", bg = "#3a3a3a" },
--         { " {cwd} ",            fg = "#fff", bg = "#3a6ea5" },
--     },
--     right_segments = {
--         { "{icon:status/error} {exit_code} ", fg = "#fff", bg = "#870000", when = "error" },
--         { "{icon:status/slow} {duration} ",   fg = "#fff", bg = "#5f5f00", when = "slow"  },
--         { " {time} ",                          fg = "#fff", bg = "#7c6ba8" },
--     },
--
--     -- Cap before the first left segment / after the last left segment /
--     -- before the first right segment.
--     head = "\u{E0B6}",
--     -- Separator drawn between adjacent segments.
--     sep = "\u{E0B0}",
--     -- Cap after the right-aligned chain.
--     tail = "\u{E0B4}",
--     -- Separator between right-side segments; falls back to `sep`.
--     sep_right = "\u{E0B3}",
--     -- Left cap of the right-aligned chain (the edge facing the input);
--     -- falls back to `head` when unset.
--     -- right_head = "\u{E0B6}",
--
--     -- Total prompt rows. 1 = single line. >= 2 puts the segments on the
--     -- first row and the input line on the last, so a right side with
--     -- the time never moves as you type.
--     lines = 2,
--     -- Prefix drawn on the input row.
--     input = "\u{E0B1} ",
--     -- strftime format for {time}.
--     time_format = "%H:%M",
--     -- Threshold, in ms, for {dur} / {exit}'s sibling and a when = "slow"
--     -- segment to render.
--     dur_min_ms = 2000,
-- }


---- Scrollback browsing ---------------------------------------------
--
-- Plain Up / Down recall command history at the prompt. Ctrl+Up breaks
-- into scrollback browse mode; then the arrow keys move the browse
-- cursor one row/column, Ctrl+arrows jump by scrollback_jump, Home / End
-- go to the start / end of its row, Enter acts on the entry under it,
-- and Escape returns to the prompt.
--
-- scrolloff: rows of context kept between the browse cursor and the
-- edge of the window while it moves through scrollback (a vim-style
-- "scrolloff"), clamped at use to leave room for the cursor itself.
--
-- scrollback_jump: how far Ctrl+Up / Ctrl+Down (rows) and Ctrl+Left /
-- Ctrl+Right (columns) jump per press while browsing (the bare arrows
-- still move one). Must be >= 1.
--
-- scrollback_type_exits: when true (the default), typing a printable
-- character while browsing returns to the prompt and inserts it; set
-- false to make browse a strict navigation mode that only Escape ends.
--
-- These live under prompt{} because that's the shell's one table
-- binding.
--
-- prompt {
--     scrolloff = 8,
--     scrollback_jump = 5,
--     scrollback_type_exits = true,
-- }
