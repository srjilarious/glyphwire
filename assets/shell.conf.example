-- Example glyphwire-shell config.
--
-- Copy to ~/.config/glyphwire/shell.conf (or $GLYPHWIRE_CONFIG_DIR, or
-- $XDG_CONFIG_HOME/glyphwire) to use it. It's a Lua script, run once at
-- shell startup; every binding below is optional.

-- Command aliases (first word only, chains followed once).
alias("ll", "ls -l")
alias("gs", "git status")

-- Prompt templating. Call prompt{ ... } with any subset of these keys;
-- multiple calls merge, last write winning per key. Leave it out entirely
-- to keep the built-in "<cwd> > " prompt.
--
-- Tokens in a template string:
--   {cwd}        working directory, $HOME shown as ~
--   {cwd_full}   working directory, absolute
--   {user}       $USER
--   {host}       hostname
--   {icon:NAME}  a bundled icon, one cell wide (e.g. distro-arch, distro-tux)
--   {exit}       expands to the `exit` sub-template below, but only when the
--                last command exited non-zero
--   {dur}        expands to the `dur` sub-template below, but only when the
--                last command ran for at least dur_min_ms
--   {{ }}        literal braces;  \n \t \\  are unescaped
--
-- Inside the `exit` sub-template: {exit_code} is the number.
-- Inside the `dur` sub-template:  {duration} is the humanized time.

prompt {
    left = "{icon:distro-arch} {cwd}{exit} > ",
    right = "{user}@{host}{dur}",
    exit = " [{exit_code}]",
    dur = "  {duration}",
    dur_min_ms = 2000,
}
