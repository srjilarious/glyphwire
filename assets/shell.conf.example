-- Example gw-shell config.
--
-- Copy to ~/.config/glyphwire/shell.conf (or $GLYPHWIRE_CONFIG_DIR, or
-- $XDG_CONFIG_HOME/glyphwire) to use it. It's a Lua script, run once at
-- shell startup; every binding below is optional. See
-- shell/shell.conf.template for the full annotated reference of prompt
-- tokens, powerline segment keys, open_actions, zj and scripts.
--
-- This is the maintainer's own working shell.conf, cleaned for sharing: a
-- two-line powerline prompt with an Arch badge, user, cwd, and a git
-- segment that only appears inside a work tree, plus a right side that
-- surfaces a non-zero exit code, a slow-command timer, and the clock.
-- The \u{E0Bx} caps/separators need a Nerd Font; glyphwire bundles a
-- Powerline-range fallback face.

prompt {
  commands = {
    -- Cheap gate: prints "true" inside a work tree, nothing outside.
    -- Every other git command hangs its `when` on this, so git never
    -- runs when you're not in a repo.
    git_repo = "git rev-parse --is-inside-work-tree 2>/dev/null",

    -- Branch name, or the short SHA on a detached HEAD.
    git_branch = {
      "git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null",
      when = "{git_repo}",
    },

    -- A dot when the work tree has any staged/unstaged/untracked change.
    git_dirty = {
      "git status --porcelain 2>/dev/null | grep -q . && echo ' ●'",
      when = "{git_repo}",
    },
  },
  left_segments = {
    { "{icon:distro/arch}", fg = "#000", bg = "#2a2a2a" },
    { " {user} ", fg = "#fff", bg = "#3a3a3a" },
    { " {icon:oxygen/folder-open} {cwd} ", fg = "#fff", bg = "#0c272f" },
    { " {icon:dev/git} {git_branch} {git_dirty} ",
      fg = "#fff", bg = "#1e6a06", when = "{git_repo}" },
  },
  right_segments = {
    { "{icon:status/error} {exit_code} ", fg = "#fff", bg = "#870000", when = "error" },
    { "{icon:status/slow} {duration} ", fg = "#fff", bg = "#5f5f00", when = "slow" },
    { " {time} ", fg = "#fff", bg = "#7C6BA8" },
  },
  head = "\u{E0B6}",       -- rounded left cap
  sep = "\u{E0B0}",        -- solid right-pointing separator
  tail = "\u{E0B4}",       -- rounded right cap
  sep_right = "\u{E0B2}",  -- solid left-pointing separator
  lines = 2,
  input = "❯ ",
  time_format = "%H:%M",
}

-- Route `ls` through the glyphwire-ls client so listings draw with icons
-- and clickable entries; `ll` is a long, size-sorted listing.
alias("ls", "gw-ls")
alias("ll", "gw-ls -lS")
