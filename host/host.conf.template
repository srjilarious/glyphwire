-- glyphwire configuration template.
--
-- This is the full reference for `host.conf`, the file glyphwire runs
-- once at startup (see host/main.zig `loadConfig`). Copy it to one of:
--
--   $GLYPHWIRE_CONFIG_DIR/host.conf
--   $XDG_CONFIG_HOME/glyphwire/host.conf
--   ~/.config/glyphwire/host.conf                  (the usual location)
--
-- Every option is listed below at its built-in default, with every line
-- commented out -- so copying this file verbatim changes nothing.
-- Uncomment and edit only the keys you want to override; a missing file
-- (or no config directory at all), or a `config` table missing a key,
-- keeps that key's default.
--
-- Syntax: it's a plain Lua script. Assign a single global table named
-- `config`. Values are Lua literals -- strings in quotes, numbers bare,
-- booleans `true` / `false`. `--` starts a comment. Unknown keys are
-- ignored. A key set to the wrong type logs a warning and the default
-- stands.
--
-- Custom icons: drop `.png` files into an `icons/` subdirectory of this
-- config directory (e.g. ~/.config/glyphwire/icons/). Each is registered
-- under its path there without the extension, so
-- icons/mine/logo.png -> the name `mine/logo`, and a file at a bundled
-- path such as icons/file/folder.png replaces that bundled icon. Use
-- the name in a prompt `{icon:...}`, a client's `draw_icon`, etc.

-- config = {
--
--     ---- Fonts --------------------------------------------------------
--
--     -- Primary font. Any of:
--     --   * a bare name -> the bundled asset of that name, resolved under
--     --     GLYPHWIRE_ASSET_DIR when set, otherwise under
--     --     ../share/glyphwire/assets relative to the glyphwire executable;
--     --   * an absolute or cwd-relative path to a TTF/OTF/TTC file;
--     --   * a system font family name ("DejaVu Sans Mono", "Fira Code")
--     --     or a fontconfig generic ("monospace") -- looked up with
--     --     `fc-match`, so fontconfig has to be installed.
--     -- A name that matches none of these warns and the bundled default
--     -- is used. For a TTC, also set `font_face_name` (a system TTC uses
--     -- the face fc-match picked unless you do).
--     font_face = "NotoSansCJK-Regular.ttc",
--
--     -- For a TTC: a substring of the desired face's name
--     -- (case-sensitive). Ignored for a plain TTF/OTF. Falls back to
--     -- face 0 if no name matches.
--     font_face_name = "Mono CJK JP",
--
--     -- Face tried for any codepoint the primary font lacks, before the
--     -- atlas falls back to its .notdef (tofu) box. Same accepted forms
--     -- as `font_face` (bundled name, path, or system family name).
--     font_fallback = "JetBrainsMono-Regular.ttf",
--
--     -- Starting cell size in pixels. Clamped to 8..72. At runtime,
--     -- Ctrl+- / Ctrl++ step it by 2 and Ctrl+0 returns to this value.
--     font_size = 20.0,
--
--     ---- Caret --------------------------------------------------------
--
--     -- Caret shape: "line" (a vertical bar at the cell's left edge, the
--     -- default), "block" (fills the cell), "box" (a hollow outline), or
--     -- "underline" (a bar along the cell's bottom). block/box/underline
--     -- cover both cells of a wide (CJK) character.
--     cursor_shape = "line",
--
--     -- Whether the caret blinks. It always shows solid the moment the
--     -- caret moves or the window scrolls, and resumes blinking once
--     -- things settle.
--     cursor_blink = true,
--
--     -- Blink half-period in milliseconds: the caret is shown for this
--     -- long, then hidden for this long. Clamped to 100..5000.
--     cursor_blink_ms = 530.0,
--
--     ---- Grid --------------------------------------------------------
--
--     -- Initial grid size in cells. The window opens this many cells
--     -- wide/tall (times the measured cell pixel size); after that it's
--     -- user-resizable and the grid tracks the window's live size.
--     -- Clamped up to 16 cols / 4 rows. A `--grid-cols` / `--grid-rows`
--     -- command-line flag overrides these.
--     grid_cols = 120,
--     grid_rows = 50,
--
--     -- Root layer scrollback depth, in rows: how many scrolled-off rows
--     -- the history ring keeps for the mouse wheel / scrollbar to reach.
--     -- Clamped to 0..100000.
--     scrollback_rows = 1000,
--
--     ---- Icons ------------------------------------------------------
--
--     -- Which bundled file-type icon set backs the canonical `file/*`
--     -- names (folder, file, image, pdf, ...) that glyphwire-ls draws
--     -- with: "oxygen" (the default, KDE Oxygen), "material" (the VS Code
--     -- Material Icon Theme), or "papirus". An unknown name, or a theme
--     -- whose icons aren't present, warns and falls back to "oxygen".
--     -- Language / tool logos (dev/zig, distro/arch, ...) are the same in
--     -- every theme.
--     icon_theme = "oxygen",
--
--     ---- Profiler ---------------------------------------------------
--
--     -- Frame-timing profiler. When off (the default) every measurement
--     -- call is a cheap early-return, so the idle redraw-on-demand path
--     -- costs nothing. When on, per-phase timings (wait, update,
--     -- sync_batches, draw, present, ...) and volume counters (layers
--     -- rebuilt, draw calls, quads) are collected and reachable over the
--     -- wire as `get_property "profile"`.
--     profile = false,
--
--     -- Whether the on-screen profiler HUD starts visible. Ctrl+Shift+P
--     -- toggles it while `profile` is true. The HUD forces a repaint
--     -- every frame while shown (bounded to ~10 Hz), so leave it off
--     -- until you want to watch the numbers.
--     profile_hud = false,
--
--     -- Start with forced every-frame redraw: the host repaints every
--     -- frame instead of only on a change, the way it did before the
--     -- redraw-on-demand work. For measuring steady-state draw cost and
--     -- A/B-ing it against the idle path. Ctrl+Shift+R toggles it while
--     -- `profile` is true.
--     profile_force_redraw = false,
--
--     -- Averaging window in milliseconds. Every profiler number (phase
--     -- avg/p95/max, per-frame counter means, fps) is accumulated over
--     -- this long and then republished, so it tracks the recent past
--     -- rather than the whole session -- like an FPS counter's 1s
--     -- bucket. Clamped to 100..10000. Set it equal to profile_log_ms
--     -- to make each logged line an average over exactly that interval.
--     profile_window_ms = 1000,
--
--     -- Cadence, in milliseconds, of a periodic profiler summary dumped
--     -- to the log (stderr). 0 disables it; any other value is clamped
--     -- to 250..60000.
--     profile_log_ms = 0,
-- }
